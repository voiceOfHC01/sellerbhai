# ==============================================================================
# Production Environment Configuration for Reply.BD Social Commerce AI Agent
# GENERATE NEW RANDOM SECRETS BEFORE DEPLOYING TO PRODUCTION!
# ==============================================================================

# Server & Domain
DOMAIN_NAME=social.yourstore.com
ENVIRONMENT=production
DEBUG=false
API_V1_STR=/api

# Security & Cryptography (CRITICAL: Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))")
SECRET_KEY=REPLACE_WITH_A_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS
# Fernet Encryption Key for Meta Tokens (Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
ENCRYPTION_KEY=REPLACE_WITH_UNIQUE_FERNET_KEY_BASE64_32_BYTES==

# Admin Owner Credentials
ADMIN_EMAIL=owner@yourstore.com
ADMIN_PASSWORD=REPLACE_WITH_STRONG_OWNER_PASSWORD_16_CHARS!

# Database & Cache (Used inside Docker Compose)
POSTGRES_USER=replybd_user
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD!
POSTGRES_DB=replybd_production

# CORS Security (Locked down: Only allow your verified production domain)
CORS_ORIGINS=["https://social.yourstore.com", "http://localhost:5173"]

# Meta Platform Credentials (From https://developers.facebook.com)
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_custom_webhook_verify_token
META_GRAPH_VERSION=v21.0

# AI Engine Settings
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=

# Store Brand Tone & Settings
STORE_NAME=Your Store Name
STORE_TONE=polite, respectful, authentic Bangladeshi social commerce merchant persona in Bangla, Banglish, and English
DEFAULT_DELIVERY_INSIDE_DHAKA=60.0
DEFAULT_DELIVERY_OUTSIDE_DHAKA=120.0
